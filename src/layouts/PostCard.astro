---
import Img from '../components/Img.astro';
import { CATEGORIES, fmt, readingTime, rtLabel } from '../lib/site';
const { post } = Astro.props; const d = post.data;
---
<a class="card" href={`/posts/${post.id}/`} data-cat={d.category}>
  {d.image && <Img class="thumb" src={d.image} alt={d.imageAlt || d.title} sizes="(max-width: 800px) 100vw, 760px" />}
  <div class="meta"><b>{CATEGORIES[d.category]}</b> · {fmt(d.date)} · {rtLabel(readingTime(post.body))}{post.id.startsWith('example') && <span class="example">ნიმუში</span>}</div>
  <h2>{d.title}</h2><p>{d.description}</p>
</a>
