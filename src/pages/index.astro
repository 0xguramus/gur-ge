---
import Base from '../layouts/Base.astro'; import PostCard from '../layouts/PostCard.astro';
import Subscribe from '../components/Subscribe.astro';
import Img from '../components/Img.astro';
import { getPosts, CATEGORIES, SITE, fmt, readingTime, rtLabel } from '../lib/site';
const posts = await getPosts();
const featured = posts.filter(p => p.data.featured).slice(0, 3);
const ICONS = { psychology: '🧠', health: '🌿', business: '📈', notes: '📝' };
const cats = Object.entries(CATEGORIES).map(([k, v]) => ({ k, v, icon: ICONS[k as keyof typeof ICONS], list: posts.filter(p => p.data.category === k) }));
---
<Base>
  <p class="meta" style="font-size:1rem;margin:0 0 24px">{SITE.description}</p>
  {featured.length > 0 && (
    <section>
      <h2 class="sec">რჩეული</h2>
      <div class="feat">{featured.map(p => (
        <a class="feat-card" href={`/posts/${p.id}/`}>
          {p.data.image ? <Img class="feat-img" src={p.data.image} alt={p.data.imageAlt || p.data.title} loading="eager" /> : <div class="feat-img feat-ph" aria-hidden="true">{ICONS[p.data.category]}</div>}
          <div class="feat-body"><div class="meta"><b>{CATEGORIES[p.data.category]}</b> · {fmt(p.data.date)} · {rtLabel(readingTime(p.body))}</div>
          <h3>{p.data.title}</h3><p>{p.data.description}</p></div>
        </a>))}
      </div>
    </section>
  )}
  <h2 class="sec">კატეგორიები</h2>
  <div class="cats">{cats.map(c => (
    <a class="cat" href={`/category/${c.k}/`}>
      <span class="cat-ico" aria-hidden="true">{c.icon}</span>
      <span class="cat-name">{c.v}</span>
      <span class="meta">{c.list.length ? `${c.list.length} ჩანაწერი` : 'მალე'}</span>
      {c.list[0] && <span class="cat-last">{c.list[0].data.title}</span>}
    </a>))}
  </div>
  <h1 class="sec" style="font-size:1.5rem">ბოლო ჩანაწერები</h1>
  <div class="chips" id="filter">
    <button class="chip active" data-f="all">ყველა</button>
    {Object.entries(CATEGORIES).map(([k, v]) => <button class="chip" data-f={k}>{v}</button>)}
  </div>
  <div id="list">{posts.map(p => <PostCard post={p} />)}</div>
  <p id="empty" class="meta" hidden>ამ კატეგორიაში ჯერ ჩანაწერი არ არის.</p>
  <Subscribe />
  <script is:inline>
    const btns=document.querySelectorAll('#filter .chip');
    btns.forEach(b=>b.onclick=()=>{btns.forEach(x=>x.classList.toggle('active',x===b));let n=0;
      document.querySelectorAll('#list .card').forEach(c=>{const s=b.dataset.f==='all'||c.dataset.cat===b.dataset.f;c.hidden=!s;n+=s});
      document.getElementById('empty').hidden=n>0;});
  </script>
</Base>
<style>
.sec{margin:28px 0 14px;font-size:1.25rem}
.feat{display:grid;gap:16px}
.feat-card{display:grid;grid-template-columns:1fr;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:var(--fg);transition:transform .15s}
.feat-card:hover{transform:translateY(-2px)}
.feat-card :global(.feat-img){display:block;width:100%;height:auto;aspect-ratio:1200/630;object-fit:cover;background:var(--chip)}
.feat-ph{display:flex!important;align-items:center;justify-content:center;font-size:3rem}
.feat-body{padding:16px 20px 18px}.feat-body h3{margin:6px 0;font-size:1.35rem}.feat-body p{margin:0;color:var(--muted)}
.cats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.cat{display:flex;flex-direction:column;gap:2px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;text-decoration:none;color:var(--fg);transition:transform .15s,border-color .15s}
.cat:hover{transform:translateY(-2px);border-color:var(--accent)}
.cat-ico{font-size:1.5rem}.cat-name{font-weight:700;line-height:1.35}
.cat-last{font-size:.82rem;color:var(--muted);line-height:1.4;margin-top:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
@media (min-width:700px){.feat-card{grid-template-columns:1.1fr 1fr}.feat-card :global(.feat-img){height:100%}}
</style>
