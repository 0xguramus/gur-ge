---
import Base from '../../layouts/Base.astro';
import PostCard from '../../layouts/PostCard.astro';
import Img from '../../components/Img.astro';
import Share from '../../components/Share.astro';
import Subscribe from '../../components/Subscribe.astro';
import Comments from '../../components/Comments.astro';
import { render } from 'astro:content';
import { getPosts, CATEGORIES, fmt, readingTime, rtLabel, tagSlug } from '../../lib/site';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props; const { Content, headings } = await render(post); const d = post.data;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;
const mine = new Set(d.tags.map(tagSlug));
const related = (await getPosts()).filter(p => p.id !== post.id)
  .map(p => ({ p, s: p.data.tags.filter(t => mine.has(tagSlug(t))).length * 2 + (p.data.category === d.category ? 1 : 0) }))
  .filter(x => x.s > 0).sort((a, b) => b.s - a.s || +b.p.data.date - +a.p.data.date).slice(0, 3).map(x => x.p);
---
<Base title={d.title} description={d.description} image={d.image}>
  <article>
    <div class="meta"><a href={`/category/${d.category}/`}><b>{CATEGORIES[d.category]}</b></a> · {fmt(d.date)} · {rtLabel(readingTime(post.body))}</div>
    <h1 style="margin-top:8px;margin-bottom:6px">{d.title}</h1>
    {d.tags.length > 0 && <div class="tags">{d.tags.map(t => <a class="tag" href={`/tags/${tagSlug(t)}/`}>#{t}</a>)}</div>}
    {d.image && <figure class="hero"><Img src={d.image} alt={d.imageAlt || d.title} loading="eager" fetchpriority="high" />{d.imageAlt && <figcaption>{d.imageAlt}</figcaption>}</figure>}
    {showToc && <details class="toc" open style="margin-top:20px"><summary>სარჩევი</summary><ol>{toc.map(h => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>}
    <div class="prose"><Content /></div>
  </article>
  <Share title={d.title} url={new URL(`/posts/${post.id}/`, Astro.site).href} />
  <Subscribe />
  {related.length > 0 && <section class="related"><h2 style="font-size:1.2rem">მსგავსი ჩანაწერები</h2>{related.map(p => <PostCard post={p} />)}</section>}
  <Comments />
  <p style="margin-top:40px"><a href="/">← ყველა ჩანაწერი</a></p>
</Base>
