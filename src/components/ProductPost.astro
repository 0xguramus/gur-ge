---
import Share from './Share.astro';
import Subscribe from './Subscribe.astro';
import Comments from './Comments.astro';
import { CATEGORIES, fmt, readingTime, rtLabel, tagSlug } from '../lib/site';
const { post, Content, headings, url } = Astro.props;
const d = post.data;
const nav = headings.filter((h: any) => h.depth === 2).map((h: any) => ({ slug: h.slug, label: h.text.split(':')[0].trim() }));
const [t1, ...rest] = d.title.split(':'); const t2 = rest.join(':').trim();
---
<div class="ap">
  <nav class="ap-nav" aria-label="გვერდის ნავიგაცია">
    <div class="ap-nav-in">
      <a href="#top" class="ap-nav-title">{t1}</a>
      <div class="ap-nav-links">{nav.map((n: any) => <a href={`#${n.slug}`} data-for={n.slug}>{n.label}</a>)}</div>
    </div>
  </nav>

  <header class="ap-hero" id="top">
    {d.kicker && <p class="ap-kicker reveal">{d.kicker}</p>}
    <h1 class="ap-h1 reveal">{t1}</h1>
    {t2 && <p class="ap-sub reveal">{t2}</p>}
    <p class="ap-meta reveal"><a href={`/category/${d.category}/`}>{CATEGORIES[d.category]}</a> · {fmt(d.date)} · {rtLabel(readingTime(post.body))}</p>
    <div class="ap-device reveal" role="img" aria-label="დასაკეცი ტელეფონის სქემატური ილუსტრაცია">
      <div class="dv-open">
        <div class="dv-half dv-l"><i></i><i></i><i></i></div>
        <div class="dv-half dv-r"><b></b><b></b><b></b><b></b><b></b></div>
      </div>
      <div class="dv-closed"><span></span></div>
    </div>
    <p class="ap-cap reveal">ილუსტრაცია სქემატურია და არ წარმოადგენს მოწყობილობის ზუსტ გამოსახულებას.</p>
  </header>

  {d.highlights.length > 0 && (
    <section class="ap-bento-wrap" aria-label="მთავარი მახასიათებლები">
      <h2 class="ap-bento-h reveal">მთავარი მახასიათებლები</h2>
      <div class="ap-bento">{d.highlights.map((h: any, i: number) => (
        <div class={`bn reveal bn-${i}`}><span class="bn-l">{h.label}</span><strong class="bn-v">{h.value}</strong>{h.note && <span class="bn-n">{h.note}</span>}</div>
      ))}</div>
    </section>
  )}

  <article class="ap-body"><Content /></article>

  <div class="ap-end">
    {d.tags.length > 0 && <div class="tags">{d.tags.map((t: string) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>#{t}</a>)}</div>}
    <Share title={d.title} url={url} />
    <Subscribe />
    <Comments />
    <p style="margin-top:32px"><a href="/">← ყველა ჩანაწერი</a></p>
  </div>
</div>

<style is:global>
.v-apple{--ap-font:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Helvetica Neue','Noto Sans Georgian',system-ui,sans-serif}
.v-apple header:not(.ap-hero){border-bottom:0;position:relative;z-index:30;background:var(--bg)}
.v-apple header:not(.ap-hero) .wrap{padding-top:10px;padding-bottom:10px}
.v-apple footer{border-top:0}
.ap{font-family:var(--ap-font);--ink:#1d1d1f;--paper:#fff;--soft:#f5f5f7;--sub:#6e6e73;--blue:#0071e3;--night:#000;--nightsoft:#161617;--nightsub:#a1a1a6;--sky:#2997ff}
[data-theme=dark] .ap{--paper:#0b0b0c;--soft:#1c1c1e;--ink:#f5f5f7;--sub:#a1a1a6;--blue:#2997ff}
.ap h1,.ap h2,.ap h3{font-family:var(--ap-font);letter-spacing:-.015em}
/* local nav */
.ap-nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--paper) 78%,transparent);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid color-mix(in srgb,var(--ink) 12%,transparent)}
.ap-nav-in{max-width:1000px;margin:0 auto;display:flex;align-items:center;gap:16px;padding:0 16px;height:48px}
.ap-nav-title{font-weight:600;color:var(--ink);text-decoration:none;white-space:nowrap;font-size:1.05rem}
.ap-nav-links{display:flex;gap:18px;overflow-x:auto;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 85%,transparent);mask-image:linear-gradient(90deg,#000 85%,transparent);padding-right:24px}
.ap-nav-links::-webkit-scrollbar{display:none}
.ap-nav-links a{font-size:.78rem;color:var(--sub);text-decoration:none;white-space:nowrap;padding:14px 0;border-bottom:2px solid transparent}
.ap-nav-links a.on{color:var(--ink);border-color:var(--ink)}
/* hero */
.ap-hero{background:var(--paper);text-align:center;padding:56px 20px 40px;overflow:hidden}
.ap-kicker{color:#bf4800;font-weight:600;font-size:1rem;margin:0 0 6px}
[data-theme=dark] .ap-kicker{color:#ff9f43}
.ap-h1{font-size:clamp(3rem,13vw,7rem);line-height:1.02;font-weight:800;margin:0;background:linear-gradient(100deg,#2b5cff 0%,#a259ff 35%,#ff5e8a 65%,#ff9f43 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.ap-sub{font-size:clamp(1.25rem,4.5vw,2rem);font-weight:600;color:var(--ink);max-width:820px;margin:14px auto 0;line-height:1.3}
.ap-meta{color:var(--sub);font-size:.9rem;margin:14px 0 0}.ap-meta a{color:var(--blue);text-decoration:none}
.ap-cap{color:var(--sub);font-size:.75rem;margin:14px 0 0}
/* CSS device */
.ap-device{display:flex;align-items:center;justify-content:center;gap:clamp(14px,4vw,40px);margin:40px auto 0;perspective:1200px}
.dv-open{display:flex;width:min(78vw,520px);aspect-ratio:1.4;background:#111;border-radius:clamp(14px,3vw,26px);padding:clamp(6px,1.4vw,12px);box-shadow:0 0 0 2px #c9c9ce,0 30px 60px -20px rgba(80,60,180,.45);transform-origin:center;animation:dvOpen 1.4s cubic-bezier(.2,.8,.2,1) both .2s}
.dv-half{flex:1;background:linear-gradient(160deg,#20243a,#2d2350);display:flex;flex-direction:column;gap:8%;padding:7% 6%}
.dv-l{border-radius:clamp(8px,2vw,16px) 0 0 clamp(8px,2vw,16px)}.dv-r{border-radius:0 clamp(8px,2vw,16px) clamp(8px,2vw,16px) 0;border-left:1px solid rgba(255,255,255,.12)}
.dv-l i{display:block;flex:1;border-radius:8px}.dv-l i:nth-child(1){background:#ff5e8a}.dv-l i:nth-child(2){background:#5b7cff}.dv-l i:nth-child(3){background:#34c3a0}
.dv-r b{display:block;height:7%;border-radius:99px;background:rgba(255,255,255,.55)}.dv-r b:nth-child(2n){width:72%}.dv-r b:nth-child(3n){width:55%}
.dv-closed{width:min(18vw,110px);aspect-ratio:.69;background:#111;border-radius:clamp(10px,2vw,18px);padding:clamp(4px,.8vw,7px);box-shadow:0 0 0 2px #c9c9ce}
.dv-closed span{display:block;height:100%;border-radius:clamp(7px,1.4vw,12px);background:linear-gradient(160deg,#20243a,#2d2350)}
@keyframes dvOpen{from{transform:rotateY(55deg) scaleX(.6);opacity:0}to{transform:none;opacity:1}}
/* bento */
.ap-bento-wrap{background:var(--soft);padding:56px 16px}
.ap-bento-h{text-align:center;font-size:clamp(1.8rem,6vw,3rem);margin:0 0 28px;color:var(--ink)}
.ap-bento{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.bn{background:var(--paper);border-radius:28px;padding:22px 20px;display:flex;flex-direction:column;gap:6px;min-height:150px;justify-content:flex-end}
.bn-l{font-size:.85rem;color:var(--sub);font-weight:600}
.bn-v{white-space:nowrap;font-size:clamp(1.35rem,6vw,2.6rem);font-weight:800;line-height:1.05;color:var(--ink);letter-spacing:-.02em}
.bn-n{font-size:.85rem;color:var(--sub);line-height:1.4}
.bn-0{grid-column:span 2;background:#000;color:#f5f5f7}.bn-0 .bn-v{background:linear-gradient(90deg,#5b9bff,#c08bff,#ff7aa2);-webkit-background-clip:text;background-clip:text;color:transparent;font-size:clamp(2.2rem,10vw,4rem)}.bn-0 .bn-l,.bn-0 .bn-n{color:#a1a1a6}
.bn-1 .bn-v{background:linear-gradient(90deg,#ff9f43,#ff5e8a);-webkit-background-clip:text;background-clip:text;color:transparent}
.bn-5{grid-column:span 2}.bn-5 .bn-v{color:var(--blue)}
@media (min-width:760px){.ap-bento{grid-template-columns:repeat(4,1fr)}.bn{min-height:200px;padding:28px}.bn-0{grid-column:span 2;grid-row:span 2}.bn-5{grid-column:span 4;min-height:140px}}
/* body sections */
.ap-body{font-size:1.06rem;line-height:1.7;background:var(--paper);padding-top:1px}
.ap-body>*:not(.md-sec){max-width:760px;margin-left:auto;margin-right:auto;padding:0 20px}
.ap-body>blockquote{margin:28px auto!important;padding:16px 20px!important;max-width:720px!important;border:0;border-radius:18px;background:var(--soft);color:var(--ink);font-size:.92rem;width:calc(100% - 32px)}
.ap-body>blockquote p{margin:0}
.md-sec{padding:64px 20px;background:var(--paper);color:var(--ink);scroll-margin-top:48px}
.md-sec:nth-of-type(even){background:var(--night);color:#f5f5f7;--sub:var(--nightsub);--soft:var(--nightsoft);--line:#333;--ink:#f5f5f7;--blue:var(--sky);--chip:#1d1d1f}
.md-sec>*{max-width:760px;margin-left:auto;margin-right:auto}
.md-sec h2{font-size:clamp(2rem,8vw,3.5rem);line-height:1.08;font-weight:800;margin-top:0;margin-bottom:24px;scroll-margin-top:60px}
.md-sec:nth-of-type(odd) h2{color:var(--ink)}
.md-sec:nth-of-type(even) h2{background:linear-gradient(90deg,#fff,#a1a1a6);-webkit-background-clip:text;background-clip:text;color:transparent}
.md-sec p,.md-sec li{color:var(--ink)}
.md-sec strong{font-weight:700}
.md-sec a{color:var(--blue)}
.md-sec ul{padding-left:1.2em}.md-sec li{margin:6px 0}
.md-sec li::marker{color:var(--sub)}
.md-sec table{display:table;table-layout:fixed;width:100%;border-collapse:separate;border-spacing:0;font-size:.95rem;margin:24px 0;border-radius:20px;overflow:hidden;background:var(--soft)}
.md-sec th,.md-sec td{padding:12px 10px;overflow-wrap:anywhere;text-align:left;border-bottom:1px solid color-mix(in srgb,var(--ink) 10%,transparent);background:transparent}
.md-sec th{font-weight:600;color:var(--sub);font-size:.8rem;text-transform:none}
.md-sec tr:last-child td{border-bottom:0}
.md-sec td:first-child{font-weight:600}
/* pros / cons cards */
.md-sec:has(.md-card){}
.md-card{background:var(--soft);border-radius:28px;padding:24px 22px;margin:16px auto}
.md-card-title{margin:0 0 10px;font-size:1.4rem}
.md-card ul{list-style:none;padding:0;margin:0}
.md-card li{position:relative;padding-left:30px;margin:10px 0}
.md-card li::before{position:absolute;left:0;top:0;font-weight:700}
.md-card[data-label="დადებითი"] .md-card-title{color:#30d158}.md-card[data-label="დადებითი"] li::before{content:"＋";color:#30d158}
.md-card[data-label="უარყოფითი"] .md-card-title{color:#ff6961}.md-card[data-label="უარყოფითი"] li::before{content:"－";color:#ff6961}
@media (min-width:860px){.md-sec:has(.md-card){display:grid;grid-template-columns:repeat(2,minmax(0,380px));justify-content:center;column-gap:16px}.md-sec:has(.md-card)>h2{grid-column:1/-1;max-width:776px;width:100%}.md-card{margin:0}}
/* verdict + sources */
.md-sec[data-for="დასკვნა"]>p:first-of-type{font-size:clamp(1.2rem,3.6vw,1.5rem);font-weight:600;line-height:1.45}
.md-sec[data-for="წყაროები"]{padding:40px 20px;font-size:.85rem}
.md-sec[data-for="წყაროები"] h2{font-size:1.25rem;background:none;color:var(--sub)!important;-webkit-text-fill-color:currentColor}
.md-sec[data-for="წყაროები"] li{color:var(--sub)}
.md-sec td:first-child,.md-sec th:first-child{width:28%}
@media (min-width:600px){.md-sec th,.md-sec td{padding:14px 16px}}
.ap-end{max-width:760px;margin:0 auto;padding:24px 20px 8px}
/* reveal */
.reveal{opacity:1}
.js-reveal .reveal,.js-reveal .md-sec>*{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.8,.2,1)}
.js-reveal .in{opacity:1!important;transform:none!important}
@media (prefers-reduced-motion:reduce){.dv-open{animation:none}.js-reveal .reveal,.js-reveal .md-sec>*{opacity:1;transform:none;transition:none}}
</style>
<script is:inline>
(function(){
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduce&&'IntersectionObserver' in window){
    document.documentElement.classList.add('js-reveal');
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.ap .reveal,.ap .md-sec>*').forEach(el=>io.observe(el));
  }
  const links=[...document.querySelectorAll('.ap-nav-links a')];
  if('IntersectionObserver' in window){
    const so=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){const id=e.target.dataset.for;links.forEach(a=>{const on=a.dataset.for===id;a.classList.toggle('on',on);if(on)a.scrollIntoView({block:'nearest',inline:'center',behavior:reduce?'auto':'smooth'})})}}),{rootMargin:'-45% 0px -50% 0px'});
    document.querySelectorAll('.md-sec').forEach(s=>so.observe(s));
  }
})();
</script>
