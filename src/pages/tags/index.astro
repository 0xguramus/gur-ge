---
import Base from '../../layouts/Base.astro';
import { getTags } from '../../lib/site';
const tags = await getTags();
---
<Base title="თეგები" description="ყველა თეგი genius.ge-ზე.">
  <h1 style="margin-top:0">თეგები</h1>
  {tags.length ? <div class="chips">{tags.map(t => <a class="chip" href={`/tags/${t.slug}/`}>#{t.name} <span class="meta">({t.count})</span></a>)}</div> : <p class="meta">თეგები ჯერ არ არის.</p>}
</Base>
