---
// Shared styles + helpers for calculators: window.GT.{fmtN, num, state, copy}
---
<style is:global>
.tool-form{display:grid;grid-template-columns:1fr 1fr;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.tool-form label{display:flex;flex-direction:column;font-size:.88rem;color:var(--muted);gap:4px}
.tool-form input,.tool-form select{font:inherit;font-size:16px;color:var(--fg);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px;width:100%;-webkit-appearance:none;appearance:none}
.tool-form input:focus,.tool-form select:focus{outline:2px solid var(--accent);border-color:transparent}
.tool-res{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:18px 0}
.tool-res>div{background:var(--chip);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.tool-res span{display:block;font-size:.8rem;color:var(--muted);line-height:1.4}.tool-res b{font-size:1.15rem;word-break:break-word;font-variant-numeric:tabular-nums}
.tool-res .hl b{color:var(--accent)}
.tool-table{overflow-x:auto;border:1px solid var(--line);border-radius:12px;margin:8px 0}
.tool-table table{width:100%;border-collapse:collapse;font-size:.9rem;font-variant-numeric:tabular-nums}
.tool-table th,.tool-table td{padding:8px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
.tool-table th{background:var(--chip);font-weight:500}.tool-table th:first-child,.tool-table td:first-child{text-align:left}
.tool-bar{display:flex;height:14px;border-radius:999px;overflow:hidden;background:var(--chip);margin:6px 0}
.tool-bar i{display:block;height:100%}
details.more{margin:12px 0}details.more summary{cursor:pointer;color:var(--accent)}
@media (max-width:560px){.tool-form{grid-template-columns:1fr}.tool-res{grid-template-columns:1fr}}
</style>
<script is:inline>
window.GT={
  // 16 387,93 — narrow no-break space thousands, comma decimals
  fmtN(v,d=2){if(!isFinite(v))return '—';const neg=v<0;v=Math.abs(v);let [i,f]=v.toFixed(d).split('.');i=i.replace(/\B(?=(\d{3})+(?!\d))/g,'\u202F');return (neg?'−':'')+i+(f?','+f:'')},
  num(id){const v=parseFloat(document.getElementById(id).value);return isFinite(v)&&v>0?v:0},
  state(ids,run){const q=new URLSearchParams(location.search);
    ids.forEach(k=>{const el=document.getElementById(k);if(!el||!q.has(k))return;const v=q.get(k);
      if(el.tagName==='SELECT'){if([...el.options].some(o=>o.value===v))el.value=v}else if(isFinite(parseFloat(v)))el.value=v});
    const save=()=>{const u=new URLSearchParams();ids.forEach(k=>{const el=document.getElementById(k);if(el&&!el.closest('[hidden]'))u.set(k,el.value)});history.replaceState(null,'','?'+u)};
    const go=()=>{run();save()};document.querySelectorAll('.tool-form').forEach(f=>{f.addEventListener('input',go);f.addEventListener('change',go)});go();return go},
  copy(btn,out){btn.onclick=async()=>{const url=location.href;let ok=false;
    try{await navigator.clipboard.writeText(url);ok=true}catch(e){const t=document.createElement('textarea');t.value=url;t.setAttribute('readonly','');t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();t.setSelectionRange(0,url.length);try{ok=document.execCommand('copy')}catch(_){}t.remove()}
    out.textContent=ok?'ბმული დაკოპირდა ✓':'კოპირება ვერ მოხერხდა — დააკოპირე მისამართის ზოლიდან.';setTimeout(()=>out.textContent='',2500)}}
};
</script>
